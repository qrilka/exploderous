#!/usr/bin/env python3
"""Reject staged, hand-maintained files larger than 5,000 tokens (bytes / 4)."""

import os
import subprocess
import sys


def git(*args):
    return subprocess.check_output(["git", *args])


# git-diff(1), RAW OUTPUT FORMAT: -z preserves paths; disabling renames gives
# one path per record. Destination modes/OIDs describe staged content, not disk.
changes = git(
    "diff", "--cached", "--raw", "--no-abbrev", "--no-renames",
    "--diff-filter=ACMT", "-z",
).split(b"\0")
oversized = []
for header, path in zip(changes[0::2], changes[1::2]):
    _, mode, _, oid, _ = header.split()
    if mode not in (b"100644", b"100755"):
        continue  # Symlinks and submodules do not contain authored file content.
    attribute = git(
        "check-attr", "--cached", "-z", "linguist-generated", "--", path,
    ).split(b"\0")[-2]
    if attribute in (b"set", b"true"):
        continue
    size = int(git("cat-file", "-s", oid))
    if size > 20_000:
        oversized.append(f"  {os.fsdecode(path)!r}: {size:,} bytes = {size / 4:,.2f} tokens")

if oversized:
    print(
        "pre-commit: staged files exceed 5,000 tokens (20,000 bytes; tokens = bytes / 4):\n"
        + "\n".join(oversized)
        + "\n\nSplit each file into cohesive files of at most 20,000 bytes:\n"
        "  - Rust code: move distinct responsibilities into child modules, e.g.\n"
        "    foo/bar.rs, and declare `mod bar;` in foo.rs. Preserve API behavior.\n"
        "  - Rust tests: move tests into foo/tests.rs with `#[cfg(test)] mod tests;`\n"
        "    in foo.rs; split larger suites into feature modules under foo/tests/.\n"
        "  - Docs: move standalone topics into separate documents and link them.\n"
        "Keep helpers with their owning responsibility; do not split arbitrarily.\n"
        "Stage all split files and updated module declarations/links with git add,\n"
        "then retry the commit. The hook measures staged content, not working files.",
        file=sys.stderr,
    )
    sys.exit(1)
